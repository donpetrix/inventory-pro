generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         String   @id @default(cuid())
  userid     String
  name       String
  sku        String?  @unique
  price      Decimal  @db.Decimal(12, 2)
  quantity   Int      @default(0)
  lowStockAt Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userid, name])
  @@index([createdAt])
}
